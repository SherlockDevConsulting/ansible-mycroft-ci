services:
  # --------- GITEA ---------
  gitea:
    image: gitea/gitea:{{ gitea_version }}
    container_name: {{ gitea_container_name }}
    labels:
      - "maintainer={{ maintainer }}"
      - "service=gitea"
      - "version={{ gitea_version }}"
      - "environment=production"
    environment:
      - USER_UID={{ gitea_user_uid }}
      - USER_GID={{ gitea_user_gid }}
      - GITEA__database__DB_TYPE={{ gitea_db_type }}
      - GITEA__database__HOST={{ gitea_db_host }}
      - GITEA__database__NAME={{ gitea_db_name }}
      - GITEA__database__USER={{ gitea_db_user }}
      - GITEA__database__PASSWD={{ gitea_db_password }}
    restart: always
    networks:
      - devops_net
    volumes:
      - gitea_data:/data
      - gitea_logs:/data/log
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    ports:
      - "{{ gitea_http_port }}"
      - "{{ gitea_ssh_port }}"
    depends_on:
      db-gitea:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{ gitea_http_port.split(':')[1] }}"]
      interval: 30s
      timeout: 10s
      retries: 5

  # --------- GITEA DB ---------
  db-gitea:
    image: docker.io/library/postgres:{{ gitea_db_version }}
    container_name: {{ gitea_db_container_name }}
    labels:
      - "project=gitea"
      - "service=postgres"
      - "version={{ gitea_db_version }}"
      - "maintainer={{ maintainer }}"
    restart: always
    environment:
      - POSTGRES_USER={{ gitea_db_user }}
      - POSTGRES_PASSWORD={{ gitea_db_password }}
      - POSTGRES_DB={{ gitea_db_name }}
    networks:
      - devops_net
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "{{ gitea_db_user }}"]
      interval: 10s
      timeout: 5s
      retries: 5

  # --------- SONARQUBE ---------
  sonarqube:
    image: sonarqube:{{ sonarqube_version }}
    container_name: {{ sonarqube_container_name }}
    labels:
      - "project=sonarqube"
      - "service=sonarqube"
      - "version={{ sonarqube_version }}"
      - "maintainer={{ maintainer }}"
    restart: always
    networks:
      - devops_net
    ports:
      - "{{ sonarqube_http_port }}"
    environment:
      SONAR_JDBC_URL: jdbc:postgresql://sonarqube-db:5432/sonarqube
      SONAR_JDBC_USERNAME: "{{ sonarqube_db_user }}"
      SONAR_JDBC_PASSWORD: "{{ sonarqube_db_password }}"
    volumes:
      - sonarqube_data:/opt/sonarqube/data
      - sonarqube_logs:/opt/sonarqube/logs
    depends_on:
      sonarqube-db:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{ sonarqube_http_port.split(':')[1] }}"]
      interval: 30s
      timeout: 10s
      retries: 5

  # --------- SONARQUBE DB ---------
  sonarqube-db:
    image: postgres:{{ sonarqube_db_version }}
    container_name: {{ sonarqube_db_container_name }}
    labels:
      - "maintainer={{ maintainer }}"
      - "service=sonarqube-db"
      - "version={{ sonarqube_db_version }}"
      - "environment=production"
    restart: always
    networks:
      - devops_net
    environment:
      POSTGRES_USER: "{{ sonarqube_db_user }}"
      POSTGRES_PASSWORD: "{{ sonarqube_db_password }}"
      POSTGRES_DB: "sonarqube"
    volumes:
      - sonarqube_db:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "{{ sonarqube_db_user }}"]
      interval: 10s
      timeout: 5s
      retries: 5
  
  # --------- JENKINS ---------
  jenkins:
    image: jenkins/jenkins:{{ jenkins_version }}
    container_name: {{ jenkins_container_name }}
    labels:
      - "maintainer={{ maintainer }}"
      - "service=jenkins"
      - "version={{ jenkins_version }}"
      - "environment=production"
    restart: always
    user: root
    networks:
      - devops_net
    ports:
      - "{{ jenkins_http_port }}"
      - "{{ jenkins_agent_port }}"
    environment:
      JENKINS_OPTS: "{{ jenkins_opts }}"
      JAVA_OPTS: "{{ jenkins_java_opts }}"
    volumes:
      - jenkins_home:/var/jenkins_home
      - /var/run/docker.sock:/var/run/docker.sock
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{ jenkins_http_port.split(':')[1] }}"]
      interval: 30s
      timeout: 10s
      retries: 5

  # --------- DOCKER REGISTRY ---------
  docker-registry:
    image: registry:{{ registry_version }}
    container_name: {{ registry_container_name }}
    labels:
      - "maintainer={{ maintainer }}"
      - "service=docker-registry"
      - "version={{ registry_version }}"
      - "environment=production"
    restart: always
    networks:
      - devops_net
    ports:
      - "{{ docker_registry_port }}"
    volumes:
      - docker_registry_data:/var/lib/registry
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://localhost:{{ docker_registry_port.split(':')[1] }}/v2/"]
      interval: 30s
      timeout: 10s
      retries: 5


networks:
  devops_net:
    external: false

volumes:
  gitea_data:
  gitea_logs:
  postgres_data:
  sonarqube_data:
  sonarqube_logs:
  sonarqube_db:
  jenkins_home:
  docker_registry_data:
