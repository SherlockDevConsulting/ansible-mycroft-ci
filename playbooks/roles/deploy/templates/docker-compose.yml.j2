networks:
  devops_net:
    external: false

services:
  gitea:
    image: gitea/gitea:{{ gitea_version }}
    container_name: {{ gitea_container_name }}
    labels:
      - "maintainer={{ maintainer }}"
      - "service=gitea"
      - "version={{ gitea_version }}"
      - "environment=production"
    environment:
      - USER_UID=1000
      - USER_GID=1000
      - GITEA__database__DB_TYPE={{ gitea_db_type }}
      - GITEA__database__HOST={{ gitea_db_host }}
      - GITEA__database__NAME={{ gitea_db_name }}
      - GITEA__database__USER={{ gitea_db_user }}
      - GITEA__database__PASSWD={{ gitea_db_password }}
    restart: always
    networks:
      - devops_net
    volumes:
      - gitea_data:/data
      - gitea_logs:/data/log
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    ports:
      {% for port in gitea_ports %}
      - "{{ port }}"
      {% endfor %}
    depends_on:
      db-gitea:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3000"]
      interval: 30s
      timeout: 10s
      retries: 5

  db-gitea:
    image: docker.io/library/postgres:{{ postgres_version }}
    labels:
      - "project=gitea"
      - "service=postgres"
      - "version={{ postgres_version }}"
      - "maintainer={{ maintainer}}"
    restart: always
    environment:
      - POSTGRES_USER={{ gitea_db_user }}
      - POSTGRES_PASSWORD={{ gitea_db_password }}
      - POSTGRES_DB={{ gitea_db_name }}
    networks:
      - devops_net
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "{{ gitea_db_user }}"]
      interval: 10s
      timeout: 5s
      retries: 5

  sonarqube:
    image: sonarqube:{{ sonarqube_version }}
    container_name: sonarqube
    restart: always
    networks:
      - devops_net
    ports:
      - "9000:9000"
    environment:
      SONAR_JDBC_URL: jdbc:postgresql://sonarqube-db:5432/sonarqube
      SONAR_JDBC_USERNAME: "{{ sonarqube_db_user }}"
      SONAR_JDBC_PASSWORD: "{{ sonarqube_db_password }}"
    volumes:
      - sonarqube_data:/opt/sonarqube/data
      - sonarqube_logs:/opt/sonarqube/logs
    depends_on:
      sonarqube-db:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9000"]
      interval: 30s
      timeout: 10s
      retries: 5

  sonarqube-db:
    image: postgres:{{ postgres_version }}
    container_name: sonarqube-db
    restart: always
    networks:
      - devops_net
    environment:
      POSTGRES_USER: "{{ sonarqube_db_user }}"
      POSTGRES_PASSWORD: "{{ sonarqube_db_password }}"
      POSTGRES_DB: "sonarqube"
    volumes:
      - sonarqube_db:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "{{ sonarqube_db_user }}"]
      interval: 10s
      timeout: 5s
      retries: 5
  
  jenkins:
    image: jenkins/jenkins:lts
    container_name: jenkins
    restart: always
    user: root
    networks:
      - devops_net
    ports:
      - "8080:8080"
      - "50000:50000"
    environment:
      JENKINS_OPTS: "--prefix=/jenkins"
      JAVA_OPTS: "-Djenkins.install.runSetupWizard=false"
    volumes:
      - jenkins_home:/var/jenkins_home
      - /var/run/docker.sock:/var/run/docker.sock
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080"]
      interval: 30s
      timeout: 10s
      retries: 5


volumes:
  gitea_data:
  gitea_logs:
  postgres_data:
  sonarqube_data:
  sonarqube_logs:
  sonarqube_db:
  jenkins_home:
